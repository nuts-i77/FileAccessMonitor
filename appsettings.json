{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Jwt": {
    "Issuer": "FileAccessMonitor",
    "Audience": "FileAccessMonitor",
    "ExpiresHours": 24
  },
  "MonitoredPaths": [],
  "ExcludeSystemAccounts": true,
  "ExcludeProcessNames": [ "System", "svchost.exe", "SearchIndexer.exe" ]
}
