[Unit]
Description=FileAccessMonitor monitoring server (web GUI and agent endpoint)
After=network-online.target smbd.service smb.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/fileaccessmonitor/FileAccessMonitor
WorkingDirectory=/opt/fileaccessmonitor
# Always an unprivileged account. Recording this machine's own Samba accesses is done by the separate
# fileaccessmonitor-collector.service (root), which fileaccessmonitor-server --collect enables;
# --port sets the web GUI port through a drop-in in /etc/systemd/system/fileaccessmonitor.service.d
User=fileaccessmonitor
Restart=always
RestartSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
